# /etc/sudoers.d/abdur-myapp   (install with: install -m 0440 -o root -g root)
# Validate before trusting it:  visudo -cf /etc/sudoers.d/abdur-myapp
#
# A1 task 4: abdur_alice and abdur_bob must be able to restart the app service and nothing
# else. Deliberately NOT used here:
#
#   %abdur_devs ALL=(ALL) NOPASSWD: ALL                  -- full root, obviously wrong
#   %abdur_devs ALL=(root) NOPASSWD: /usr/bin/systemctl  -- lets them `systemctl edit
#                                                     anything`, or restart sshd
#   %abdur_devs ALL=(root) NOPASSWD: /usr/bin/systemctl restart *
#                                                  -- the wildcard matches
#                                                     `restart sshd`, and with
#                                                     some subcommands it can be
#                                                     walked into a root shell
#
# Each command is spelled out in full, with both paths systemctl lives at on
# Ubuntu (/usr/bin is the real one, /bin is a symlink; sudo matches the path as
# typed, so both are listed).

Cmnd_Alias ABDUR_MYAPP_CTL = /usr/bin/systemctl restart abdur-myapp,         \
                       /usr/bin/systemctl restart abdur-myapp.service, \
                       /usr/bin/systemctl start   abdur-myapp,         \
                       /usr/bin/systemctl start   abdur-myapp.service, \
                       /usr/bin/systemctl stop    abdur-myapp,         \
                       /usr/bin/systemctl stop    abdur-myapp.service, \
                       /usr/bin/systemctl status  abdur-myapp,         \
                       /usr/bin/systemctl status  abdur-myapp.service, \
                       /bin/systemctl restart abdur-myapp,             \
                       /bin/systemctl restart abdur-myapp.service,     \
                       /bin/systemctl start   abdur-myapp,             \
                       /bin/systemctl stop    abdur-myapp,             \
                       /bin/systemctl status  abdur-myapp

# Reading the service journal is read-only and useful; -u is pinned to abdur-myapp.
Cmnd_Alias ABDUR_MYAPP_LOG = /usr/bin/journalctl -u abdur-myapp, \
                       /usr/bin/journalctl -u abdur-myapp *

%abdur_devs ALL=(root) NOPASSWD: ABDUR_MYAPP_CTL, ABDUR_MYAPP_LOG

# abdur_carol is a member of abdur_devs as well, so she inherits the rule above.
# abdur_dan is in `abdur_auditor` only and appears nowhere here: sudo will refuse him.
