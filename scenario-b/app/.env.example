# Copy to .env for local runs. .env is gitignored and must NEVER be committed --
# a committed .env is an instant zero for this scenario.
DATABASE_URL=postgres://notes:notes@localhost:5432/notes
PORT=3000
APP_VERSION=v1
# Set to 1 to build the deliberately broken v3 image (B4 task 38): /healthz
# starts returning 500 so the container healthcheck never passes.
BREAK_HEALTHZ=0
