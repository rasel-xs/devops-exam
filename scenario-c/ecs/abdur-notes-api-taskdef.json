{
  "family": "abdur-notes-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/abdur-ecs-task-execution-role",
  "containerDefinitions": [
    {
      "name": "notes-api",
      "image": "<ACCOUNT_ID>.dkr.ecr.eu-north-1.amazonaws.com/abdur-notes-api:v1.0.69",
      "essential": true,
      "command": ["sh", "-c", "node db/migrate.js && node src/server.js"],
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "DATABASE_URL", "value": "postgres://notes@abdur-notes-db.c9c4ku2mkinq.eu-north-1.rds.amazonaws.com:5432/notes?sslmode=no-verify" }
      ],
      "secrets": [
        { "name": "PGPASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-north-1:<ACCOUNT_ID>:secret:rds!db-4a1bc93e-3f90-48ff-bbed-79a654515fef-hCSwAq:password::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --quiet --tries=1 --spider http://127.0.0.1:3000/healthz || exit 1"],
        "interval": 10,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/abdur-notes-api",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "notes-api"
        }
      }
    }
  ],
  "tags": [
    { "key": "exam-token", "value": "root-vmi3536696-1788282556-1536d427" }
  ]
}
